{
  "version": 1,
  "name": "샘플 - 커뮤니티 핫딜 수집 (클리앙 + 루리웹 RSS + 뽐뿌 RSS)",
  "nodes": [
    { "id": "hd0001", "type": "INJECT", "x": 40, "y": 40,
      "options": { "message": "clien", "intervalMillis": 600000 } },
    { "id": "hd0002", "type": "HTTP_REQUEST", "x": 340, "y": 40,
      "options": { "url": "https://www.clien.net/service/board/jirum", "userAgent": "yesde-red/1.0",
                   "timeoutMillis": 15000, "minIntervalMillis": 5000 } },
    { "id": "hd0003", "type": "HTML_EXTRACT", "x": 640, "y": 40,
      "options": { "selector": "div.list_item.symph_row", "xml": false,
                   "fields": "category = span.icon_keyword\ntitle = span.list_subject > a:not(.list_reply)\nlink = span.list_subject > a:not(.list_reply) @href\ncomments = span.rSymph05\nhits = span.hit\ntime = span.timestamp" } },

    { "id": "hd0011", "type": "INJECT", "x": 40, "y": 180,
      "options": { "message": "ruliweb", "intervalMillis": 600000 } },
    { "id": "hd0012", "type": "HTTP_REQUEST", "x": 340, "y": 180,
      "options": { "url": "https://bbs.ruliweb.com/market/board/1020/rss", "userAgent": "yesde-red/1.0",
                   "timeoutMillis": 15000, "minIntervalMillis": 5000 } },
    { "id": "hd0013", "type": "HTML_EXTRACT", "x": 640, "y": 180,
      "options": { "selector": "item", "xml": true,
                   "fields": "category = category\ntitle = title\nlink = link\nauthor = author\ntime = pubDate" } },

    { "id": "hd0031", "type": "INJECT", "x": 40, "y": 320,
      "options": { "message": "ppomppu", "intervalMillis": 600000 } },
    { "id": "hd0032", "type": "HTTP_REQUEST", "x": 340, "y": 320,
      "options": { "url": "https://www.ppomppu.co.kr/rss.php?id=ppomppu", "userAgent": "yesde-red/1.0",
                   "timeoutMillis": 15000, "minIntervalMillis": 5000 } },
    { "id": "hd0033", "type": "HTML_EXTRACT", "x": 640, "y": 320,
      "options": { "selector": "item", "xml": true,
                   "fields": "title = title\nlink = link\nauthor = author\ntime = pubDate\nhits = hits\ndescription = description" } },

    { "id": "hd0020", "type": "DEDUPE", "x": 940, "y": 180,
      "options": { "key": "link", "maxEntries": 100000, "storePath": "output/hotdeal-seen.txt" } },
    { "id": "hd0021", "type": "FILE_WRITE", "x": 1240, "y": 100,
      "options": { "path": "output/hotdeal.csv", "format": "CSV",
                   "fields": "url\ncategory\ntitle\nlink\nauthor\ncomments\nhits\ntime", "append": true } },
    { "id": "hd0022", "type": "DEBUG", "x": 1240, "y": 260, "options": {} }
